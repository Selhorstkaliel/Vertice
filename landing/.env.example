# Endereço público da landing, sem barra no final (ex.: https://seudominio.com.br).
# Quando definido, o build gera canonical, og:url, og:image absoluto, sitemap.xml e a linha Sitemap do robots.txt.
VITE_SITE_URL=

# Endereço do aplicativo VÉRTICE (o app Next.js na raiz do repositório, ex.: http://localhost:3000).
# Quando definido, as páginas /login, /cadastro e /dashboard levam para o app real.
VITE_APP_URL=
