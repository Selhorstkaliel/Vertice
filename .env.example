# Banco de dados — corresponde ao docker-compose.yml
DATABASE_URL="postgresql://vertice:vertice_dev@localhost:5433/vertice?schema=public"

# Segredo de sessão. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca reutilize o valor de exemplo em produção.
SESSION_SECRET="troque-este-valor-por-32-bytes-aleatorios"

# URL pública da aplicação (usada em links de recuperação de senha)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Landing pública (projeto em landing/). A raiz do aplicativo redireciona para ela.
NEXT_PUBLIC_LANDING_URL=""

# Vértice Mentor (opcional). Sem provedor configurado, o Mentor oferece apenas as
# análises automáticas baseadas em regras; nenhuma resposta de IA é simulada.
#
# Opção 1: Google Gemini (tem plano gratuito). Chave em https://aistudio.google.com/apikey
# MENTOR_PROVIDER="gemini"
# GEMINI_API_KEY="..."
# MENTOR_MODEL="gemini-3.5-flash-lite"   # opcional; use outro modelo listado no AI Studio se preferir
#
# Opção 2: Anthropic (Claude)
# MENTOR_PROVIDER="anthropic"
# ANTHROPIC_API_KEY="sk-ant-..."
# MENTOR_MODEL="claude-sonnet-5-5"   # padrão; troque só se outro modelo passar no npm run mentor:check
# MENTOR_FALLBACKS="default"        # default | off (modelo reserva para respostas recusadas)
#
# Opção 3: qualquer API compatível com OpenAI (Groq, Ollama, OpenRouter...)
# MENTOR_PROVIDER="openai-compatible"
# MENTOR_BASE_URL="http://localhost:11434/v1"
# MENTOR_MODEL="qwen2.5:14b"
# MENTOR_API_KEY="..."              # se o provedor exigir
#
# Comuns a todos
# MENTOR_EFFORT="medium"            # low | medium | high (Claude aceita também xhigh e max); padrão medium com Anthropic
# MENTOR_DAILY_LIMIT="30"           # mensagens por estudante por dia
# MENTOR_MAX_ROUNDS="5"             # chamadas ao modelo por mensagem (rodadas de consulta aos dados)
# GEMINI_PAID_TIER="off"            # em produção, o Mentor só usa Gemini com "on" (plano pago): o plano gratuito pode usar os dados
#
# Depois de configurar, verifique com: npm run mentor:check

# Banco de questões a partir de provas oficiais (leitura de PDFs e questões geradas).
# Usa GEMINI_API_KEY mesmo quando o Mentor usa outro provedor.
# GEMINI_API_KEY="..."
# QUESTION_AI_MODELS="gemini-3.5-flash-lite,gemini-3.6-flash"   # em ordem; o próximo assume quando a cota diária acaba
# STORAGE_DIR="storage"                                          # PDFs, páginas e figuras; inclua no backup

# Área de redação (correção por IA, Claude). Usa ANTHROPIC_API_KEY.
# ESSAYS_ENABLED="off"              # vazio: ligada em desenvolvimento, desligada em produção até a calibração passar
# ESSAY_MODEL="claude-sonnet-5-5"   # escolha com npm run redacao:calibrar (o mais barato que passar)
# ESSAY_REWRITE_MODEL="claude-sonnet-5-5"
# ESSAY_THEME_MODEL="claude-sonnet-5-5"
# ESSAY_EFFORT="medium"
# ESSAY_MONTHLY_LIMIT="8"           # correções por aluno por mês
# ESSAY_REWRITE_MONTHLY_LIMIT="20"  # reescritas de parágrafo por aluno por mês
# ESSAY_DISAGREEMENT_THRESHOLD="0.12" # diferença entre as duas correções (fração da nota máxima) que marca "correção incerta"
# ESSAY_RANGE_MARGIN="0.04"         # folga somada a cada lado da faixa estimada

# Lembretes de prazo das etapas por e-mail. Fica "off" até existir provedor de e-mail (src/modules/auth/mailer.ts).
# STAGE_REMINDER_EMAILS="off"

# Busca automática de editais (npm run editais). Lista de fontes em prisma/fontes-editais.json.
# EDITAL_AI_MODELS="gemini-3.5-flash-lite,gemini-3.6-flash"  # leitura dos editais; usa GEMINI_API_KEY
# EDITAIS_MIN_INTERVAL_HOURS="8"    # intervalo mínimo entre duas verificações da mesma fonte
# EDITAIS_FAILURES_ALERT="3"        # falhas seguidas até a fonte aparecer como "precisa de atenção"
# INLABS_EMAIL="..."                # Diário Oficial (INLABS, Imprensa Nacional): cadastro gratuito em https://inlabs.in.gov.br
# INLABS_SENHA="..."
